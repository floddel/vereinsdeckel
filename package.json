{
  "name": "vereinsdeckel",
  "version": "1.0.0",
  "description": "Vereinsdeckel – der digitale Bierdeckel für Vereine",
  "license": "AGPL-3.0-only",
  "author": "floddel",
  "repository": {
    "type": "git",
    "url": "https://github.com/floddel/vereinsdeckel.git"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:reset": "rm -rf .data/dev",
    "db:reset-buchungen": "node --env-file-if-exists=.env.local scripts/reset-buchungen.mjs",
    "vercel-build": "node scripts/vercel-build.mjs",
    "docs:bilder": "DOKU_BILDER=1 playwright test --project=setup --project=doku"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@electric-sql/pglite": "^0.5.10",
    "@react-pdf/renderer": "4.9.0",
    "better-auth": "^1.7.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "html-to-image": "^1.11.13",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents": false
  }
}
