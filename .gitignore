# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Vorlage für Umgebungsvariablen darf ins Repository
!.env.example

# lokale Datenbanken (PGlite)
/.data/

# Playwright
/playwright-report/
/test-results/
/blob-report/

# Werkzeuge für Claude Code und Neon (Skills, MCP, Projekt-Verknüpfung) – nicht Teil der App
/.claude/
/skills-lock.json
/.mcp.json
/.neon

# Datenordner von Docker Compose (./daten)
/daten/

# Interne Planung – bleibt nur lokal
/PLAN.md

# Hinweise für KI-Assistenten (legt next dev selbst an) – nur lokal
/AGENTS.md
