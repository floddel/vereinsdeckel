# Vorlage für .env.local (die echte Datei kommt NIE ins Git-Repository).
# Kopieren: cp .env.example .env.local

# Datenbank – zwei Wege:
# 1. Eingebaute Datenbank (PGlite, keine Zusatzsoftware): Daten liegen in einem Ordner.
#    PGLITE_DIR = genau dieser Ordner; sonst DATA_DIR/db; sonst .data/dev
PGLITE_DIR=.data/dev
# DATA_DIR=/data
# 2. Ein PostgreSQL (Neon, Supabase, eigener Server): dann wird die eingebaute nicht benutzt.
#    Bei Neon die Adresse mit „-pooler“ nehmen.
# DATABASE_URL=postgresql://benutzer:passwort@host/datenbank?sslmode=require
# DATABASE_POOL_MAX=5

# Beispielartikel anlegen, wenn noch keine Artikel existieren (nur Entwicklung)
SEED_EXAMPLES=1

# Anmeldung:
# BETTER_AUTH_SECRET=   # langer Zufallswert, z. B. mit: openssl rand -base64 32
# BETTER_AUTH_URL=http://localhost:3000

# Einrichtungs-Code: ohne ihn kann niemand das erste Admin-Konto anlegen (in Produktion Pflicht,
# mindestens 16 Zeichen), z. B. mit: openssl rand -base64 24
# SETUP_CODE=

# Produktion:
# Endgültige öffentliche Adresse für Mitglieder-Links und QR-Karten (ohne / am Ende).
# Ohne APP_URL wird die Adresse aus der Anfrage genommen (lokal z. B. http://192.168.…:3000).
# APP_URL=https://vereinsdeckel.example.org
